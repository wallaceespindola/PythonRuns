# CNJ DataJud public API key, used by pythonruns/src/mytests/jusbr/call_api_trf_proc.py
# Get the current key at https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Secret for pythonruns/src/mytests/jwt_test.py (random per run if unset)
JWT_SECRET_KEY=

# pythonruns/src/mytests/backup_restore_wordpress.py (host must already be in ~/.ssh/known_hosts)
WP_LOCAL_PATH=
WP_LOCAL_DB_NAME=local
WP_LOCAL_DB_USER=
WP_LOCAL_DB_PASSWORD=
WP_REMOTE_SERVER=
WP_REMOTE_USER=
WP_REMOTE_PASSWORD=
WP_REMOTE_KEY_FILE=~/.ssh/id_ed25519
WP_REMOTE_PATH=/var/www/site/
WP_REMOTE_DB_NAME=site
WP_REMOTE_DB_USER=
WP_REMOTE_DB_PASSWORD=
